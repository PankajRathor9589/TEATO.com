# TEATO Server - Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/teato

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Razorpay (India payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps API (for address/location)
GOOGLE_MAPS_API_KEY=

# File upload (local storage path)
UPLOAD_PATH=./uploads

# Rate limiting (requests per 15 min per IP)
RATE_LIMIT_MAX=100

# Push notifications (optional - Web Push VAPID public key for client)
# VAPID_PUBLIC_KEY=
